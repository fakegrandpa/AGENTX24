# AGENTX24 Environment Configuration

# Required: Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Secondary Tool API Keys (if available)
SEMANTIC_SCHOLAR_API_KEY=
NEWSDATA_API_KEY=
EPO_OPS_KEY=
EPO_OPS_SECRET=
