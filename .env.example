# AGENTX24 Environment Configuration
# Copy this file to .env and fill in the values. .env is git-ignored.

# Required: Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Agent loop budgets. Defaults shown; uncomment to override.
# MAX_ITERATIONS=8
# MAX_TOOL_CALLS=12
# TOOL_TIMEOUT=15.0
# WALL_CLOCK=120.0
# TOOL_RETRIES=1
# LLM_RETRIES=2

# Optional: Secondary Tool API Keys (if available)
# research_search falls back to OpenAlex + arXiv without any key.
SEMANTIC_SCHOLAR_API_KEY=
# news_search falls back to Google News RSS without any key.
NEWSDATA_API_KEY=
# patent_search uses web-indexed Google Patents records without any key;
# EPO OPS credentials are preferred when available.
EPO_OPS_KEY=
EPO_OPS_SECRET=
